custom-shader = shaders/cursor_smear.glsl

theme = dark:everforest-dark,light:everforest-light

font-family = JetBrainsMono Nerd Font Mono
font-size = 14

macos-titlebar-style = tabs
window-width = 145
window-height = 38

background-opacity = 0.98
background-blur = 10

cursor-style = bar
# cursor-color = cell-foreground

keybind = cmd+f=toggle_split_zoom

keybind = super+h=goto_split:left
keybind = super+j=goto_split:bottom
keybind = super+k=goto_split:top
keybind = super+l=goto_split:right

keybind = cmd+h=previous_tab
keybind = cmd+l=next_tab

keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+k=resize_split:up,10
keybind = super+ctrl+l=resize_split:right,10
