custom-shader = shaders/cursor_smear.glsl

theme = dark:everforest-dark, light:everforest-light

font-family = ZedMono NFM
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-feature = ss01 ss02 ss10 ss17

font-size = 16

adjust-cell-height = 5

macos-titlebar-style = tabs

window-width = 145
window-height = 40 

background-opacity = 1
background-blur = 0

cursor-style = bar
# cursor-color = cell-foreground

keybind = cmd+f=toggle_split_zoom

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right

keybind = super+ctrl+h=resize_split:left,20
keybind = super+ctrl+j=resize_split:down,20
keybind = super+ctrl+k=resize_split:up,20
keybind = super+ctrl+l=resize_split:right,20

keybind = super+ctrl+d=new_split:down
keybind = super+ctrl+s=new_split:right
